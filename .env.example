# ─── Bot Core ──────────────────────────────────────────────
PORT=3000
SERVER_IP=localhost
PREFIX=.
OWNER_NUMBER=923001234567

# ─── Dashboard Auth ─────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASS=xortlogix
# AUTH_SECRET is auto-generated if not set (recommended to leave blank)

# ─── n8n Integration (DISABLED — Standalone AI Agent in use) ────────────────
# Set N8N_ENABLED=false to keep n8n fully disabled
N8N_ENABLED=false
N8N_INTEGRATION_ENABLED=false
N8N_WEBHOOK_URL=
N8N_BOT_SECRET=
N8N_TIMEOUT=10000

# ─── Phase 1: PostgreSQL Database ────────────────────────────
POSTGRES_DB=cravey_crust
POSTGRES_USER=cravey
POSTGRES_PASSWORD=change-this-strong-password-minimum-32-chars
DATABASE_URL=postgresql://cravey:change-this-strong-password-minimum-32-chars@cravey-postgres:5432/cravey_crust

# ─── Phase 1: Redis (optional cache/session layer) ────────────
REDIS_PASSWORD=change-this-redis-password-minimum-32-chars
REDIS_URL=redis://:change-this-redis-password-minimum-32-chars@cravey-redis:6379

# ─── Feature Flags ────────────────────────────────────────────
RESTAURANT_DB_ENABLED=true
CORE_ORDER_ENGINE_ENABLED=true
REALTIME_DASHBOARD_ENABLED=true
KNOWLEDGE_BASE_ENABLED=true
WHATSAPP_ORDERING_ENABLED=true
CUSTOM_AI_ENABLED=false

# ─── Phase 2: Restaurant Dashboard & Internal APIs ─────────
INTERNAL_API_SECRET=bot-internal-secret-phase2

# ─── Standalone AI Agent Configuration ─────────────────────────
# Enable standalone mode: n8n is completely bypassed
STANDALONE_AI_ENABLED=true

# Primary & Fallback AI Providers
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=deepseek
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024

# Gemini API Keys (comma-separated for round-robin rotation)
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek API Keys (comma-separated)
DEEPSEEK_API_KEYS=key1,key2
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API Keys (comma-separated)
OPENAI_API_KEYS=key1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

